generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model artists {
  artist_id         Int               @id @default(autoincrement())
  name              String            @db.VarChar(100)
  email             String            @unique @db.VarChar(150)
  password_hash     String?           @db.VarChar(255)
  bio               String?
  country           String?           @db.VarChar(100)
  profile_image_url String?
  auth_provider     String?           @default("local") @db.VarChar(50)
  provider_id       String?           @db.VarChar(255)
  created_at        DateTime?         @default(now()) @db.Timestamp(6)
  updated_at        DateTime?         @default(now()) @db.Timestamp(6)
  artist_sessions   artist_sessions[]
}

model artist_sessions {
  session_id    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artist_id     Int?
  refresh_token String?   @db.VarChar(255)
  expires_at    DateTime? @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  artists       artists?  @relation(fields: [artist_id], references: [artist_id], onDelete: Cascade, onUpdate: NoAction)
}
