
generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["artists"]
}

model Artist {
  id                String    @id @default(cuid())
  name              String    @db.VarChar(100)
  email             String    @unique(map: "artists_email_key") @db.VarChar(150) 
  bio               String?
  country           String?   @db.VarChar(100)
  profile_image_url String?
  auth_provider     String?   @default("local") @db.VarChar(50)
  email_verified    Boolean   @default(false)
  provider_id       String?   @db.VarChar(255)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  sessions          Session[]
  accounts          Account[]

  @@map("artist")
  @@schema("artists")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@map("session")
  @@schema("artists")
  @@index([artistId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  artistId              String
  artist                Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@map("account")
  @@schema("artists")
  @@index([artistId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
  @@schema("artists")
  @@index([identifier])
}

