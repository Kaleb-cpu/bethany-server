{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "lib": ["esnext"],
    "typeRoots": [
      "./node_modules/@types",
      "./prisma/generated/client",
      "./types" 
    ],
    "baseUrl": ".", 
    "paths": {
    "$lib/*": ["lib/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "lib/**/*.ts",
    "prisma/generated/client/**/*.ts",
    "fastify.d.ts",
     
  ],
  "exclude": ["node_modules", "dist"]
}