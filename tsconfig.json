{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".dist",
    "rootDir": "./",
    "sourceMap": true,
    "lib": ["esnext"]
  },
  "include": [
    "index.ts",
    "prisma/generated/client/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}